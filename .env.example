# Copy is generated by `make setup` with a random local password. Never commit .env.
GHOST_ROUTES_DB_USER=ghost_routes
GHOST_ROUTES_DB_PASSWORD=change-me-local-only
GHOST_ROUTES_DB_NAME=ghost_routes
GHOST_ROUTES_DB_PORT=55432
GHOST_ROUTES_DATABASE_URL=postgresql+psycopg://ghost_routes:change-me-local-only@127.0.0.1:55432/ghost_routes
# Uploads, crops, raw model responses and bundles live here, outside the repo.
GHOST_ROUTES_STATE_DIR=~/.local/state/ghost-routes
# Native Ollama on the host. From inside a container use http://host.docker.internal:11434.
GHOST_ROUTES_OLLAMA_URL=http://127.0.0.1:11434
GHOST_ROUTES_MODEL=qwen2.5vl:7b
GHOST_ROUTES_API_HOST=127.0.0.1
GHOST_ROUTES_API_PORT=8077
GHOST_ROUTES_WEB_PORT=5177
