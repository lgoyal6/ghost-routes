{
  "name": "ghost-routes-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port ${GHOST_ROUTES_WEB_PORT:-5177} --strictPort",
    "build": "tsc --noEmit && vite build",
    "gen:api": "cd ../.. && uv run ghost-routes openapi -o apps/web/openapi.json && cd apps/web && openapi-typescript openapi.json -o src/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src e2e",
    "e2e": "playwright test",
    "e2e:offline": "playwright test --grep-invert @live"
  },
  "dependencies": {
    "openapi-fetch": "0.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@eslint/js": "9.15.0",
    "@playwright/test": "1.49.0",
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.15.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "globals": "15.12.0",
    "openapi-typescript": "7.4.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vite": "5.4.11"
  },
  "overrides": {
    "playwright-core": "1.49.0"
  }
}
